# Maintainer: Zius <zius@localhost>
pkgname=settings-tui
pkgver=0.1.0
pkgrel=1
pkgdesc="A production-grade universal Linux Settings Center for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/zius/settings-tui"
license=('MIT' 'Apache-2.0')
depends=('gcc-libs' 'glibc' 'dbus' 'systemd-libs')
makedepends=('cargo')
optdepends=(
    'networkmanager: for Wi-Fi and network management'
    'bluez: for Bluetooth management'
    'wireplumber: for audio volume and device management'
    'upower: for battery and power profile management'
    'hyprland: for display resolution control on Wayland'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    cargo test --locked
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "extra/$pkgname.desktop" "$pkgdir/usr/share/applications/$pkgname.desktop"
    install -Dm644 "extra/settings-tui.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
