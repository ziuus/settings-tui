# Maintainer: Zius <zius@localhost>
pkgname=settings-tui-bin
pkgver=0.1.14
pkgrel=1
pkgdesc="A hyper-lightweight (<9MB, near 0% CPU) universal Linux Settings Center for the terminal written in Rust"
arch=('x86_64')
url="https://github.com/ziuus/settings-tui"
license=('MIT')
depends=('dbus')
optdepends=(
    'bluez: Bluetooth management support'
    'networkmanager: Wi-Fi and VPN management support'
    'pipewire: Audio sink/source controls'
    'wireplumber: WirePlumber audio controls'
    'hyprland: Hyprland display and monitor management'
    'upower: Battery telemetry and power profile support'
    'systemd: Services and systemctl controls'
)
provides=('settings-tui')
conflicts=('settings-tui')
source=("https://registry.npmjs.org/settings-tui/-/settings-tui-${pkgver}.tgz")
sha256sums=('SKIP')

package() {
    cd "${srcdir}/package"
    install -Dm755 bin/settings-tui "${pkgdir}/usr/bin/settings-tui"
    ln -sf /usr/bin/settings-tui "${pkgdir}/usr/bin/settings"
    install -Dm644 LICENSE-MIT "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
